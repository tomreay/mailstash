{
  "name": "mailstash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "worker": "node scripts/start-worker.mjs",
    "worker:setup": "node scripts/setup-graphile-worker.js"
  },
  "resolutions": {
    "google-auth-library": "10.5.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.101.4",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.3",
    "@types/formidable": "^3.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.7.0",
    "cronstrue": "^3.24.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.4",
    "googleapis": "^174.0.1",
    "graphile-worker": "^0.17.3",
    "imapflow": "^1.6.6",
    "lucide-react": "^1.30.0",
    "mailparser": "^3.9.15",
    "next": "15.4.1",
    "next-auth": "^5.0.0-beta.32",
    "node-mbox": "^2.0.0",
    "p-retry": "^7.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "prettier": "3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  }
